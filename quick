#include <vector>
#include <iostream>
using namespace std;

template <class It, class Compare = std::less<>>
void quick_sort(It first, It last, Compare cmp = Compare{}) {
    if (first >= last) return;
    It p = last - 1;
    It i = first;
    for (It j = first; j != p; ++j) {
        if (cmp(*j, *p)) {
            swap(*i, *j);
            ++i;
        }
    }
    swap(*i, *p);
    quick_sort(first, i, cmp);
    quick_sort(i + 1, last, cmp);
}

int main() {
    vector<int> x = {10,5,8,1,4,3,7,6};
    int num;
    quick_sort(x.begin(), x.end());
    for (int i : x) {
        cout << i << " ";
    }
    
    return 0;
}
